{
    "compilerOptions": {
        "target": "ES2023",
        "lib": ["dom", "dom.iterable", "esnext"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noEmit": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "allowImportingTsExtensions": true,
        "jsx": "react-jsx",
        "incremental": true,
        "skipLibCheck": true,
        "plugins": [
            {
                "name": "next"
            }
        ],
        "paths": {
            "@/*": ["./src/*"]
        },
        "allowJs": true,
        "esModuleInterop": true
    },
    "include": [
        "next-env.d.ts",
        "src/**/*.ts",
        "src/**/*.tsx",
        ".next/types/**/*.ts",
        "drizzle.config.ts",
        ".next/dev/types/**/*.ts"
    ],
    "exclude": ["node_modules", "tools"]
}
